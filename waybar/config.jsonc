{
    "layer": "top",
    "position": "top",
    "height": 50,
    "modules-left": ["custom/logo", "wlr/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/wallpaper"],

    "wlr/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\\n<tt><small>{calendar}</small></tt>"
    },
    "custom/logo": {
        "format": "",
        "tooltip": false
    },
    "custom/wallpaper": {
        "format": "",
        "on-click": "~/.config/scripts/change_wallpaper.sh"
    }
}
