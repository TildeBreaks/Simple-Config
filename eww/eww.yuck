;; Global variable definitions
(defvar battery '{"capacity": 0, "status": "Unknown"}')
(defvar battery_icon "󰁿")
(defvar workspaces "[]")
(defvar keybindings "[]")
(defvar active_workspace 1)
(defvar memory_used "0")
(defvar memory_total "0")
(defvar disk_used "0")
(defvar disk_total "0")
(defvar network '{"connected": false, "ssid": "Disconnected"}')

;; Poll for system data
(defpoll cpu_usage :interval "2s" "scripts/system-monitor.sh cpu")
(defpoll memory_usage :interval "2s" "scripts/system-monitor.sh memory | cut -d'|' -f1")
(defpoll disk_usage :interval "2s" "scripts/system-monitor.sh disk | cut -d'|' -f1")
(defpoll time :interval "1s" "date +'{\"%H:%M\": \"%H:%M\", \"%Y-%m-%d\": \"%Y-%m-%d\"}'")
(defpoll volume :interval "1s" "scripts/system-monitor.sh volume | cut -d'|' -f1")
(defpoll load_avg :interval "2s" "scripts/system-monitor.sh load")

(defwindow keybinding-popup
  :monitor 0
  :geometry (geometry :x "50%"
                       :y "50%"
                       :width "800px"
                       :height "600px"
                       :anchor "center")
  :stacking "overlay"
  :focusable true
  (keybinding-manager))

(defwindow system-monitor
  :monitor 0
  :geometry (geometry :x "50%"
                       :y "50%"
                       :width "400px"
                       :height "300px"
                       :anchor "center")
  :stacking "overlay"
  :focusable true
  (system-monitor-widget))

(defwidget keybinding-manager []
  (box :class "keybinding-manager"
       :orientation "v"
       :spacing 16
    (box :class "popup-header"
         :orientation "h"
         :space-evenly false
         :halign "space-between"
      (label :class "popup-title"
              :text "⌨️ Keybinding Manager")
      (button :class "close-button"
              :onclick "eww close keybinding-popup"
        (label :text "✕")))
    (scroll :class "keybindings-scroll"
            :hscroll true
            :vscroll true
      (box :class "keybindings-list"
           :orientation "v"
           :spacing 8
        (for binding in keybindings
          (box :class "keybinding-item"
               :orientation "h"
               :space-evenly false
               :halign "space-between"
            (box :class "keybinding-info"
                 :orientation "h"
                 :spacing 12
              (label :class "keybinding-keys"
                      :text "${binding.keys}")
              (label :class "keybinding-action"
                      :text "${binding.action}"))
            (box :class "keybinding-controls"
                 :orientation "h"
                 :spacing 8
              (button :class "execute-button"
                      :onclick "sh -c '${binding.command}'"
                (label :text "▶"))
              (button :class "edit-button"
                      :onclick "eww update editing_keybinding=${binding.id}"
                (label :text "✏")))))))))

(defwidget system-monitor-widget []
  (box :class "system-monitor"
       :orientation "v"
       :spacing 16
    (box :class "popup-header"
         :orientation "h"
         :space-evenly false
         :halign "space-between"
      (label :class "popup-title"
              :text "󰍛 System Monitor")
      (button :class "close-button"
              :onclick "eww close system-monitor"
        (label :text "✕")))
    (box :class "monitor-grid"
         :orientation "v"
         :spacing 12
      (cpu-details)
      (memory-details)
      (disk-details)
      (network-details))))

(defwidget cpu-details []
  (box :class "monitor-section"
       :orientation "v"
       :spacing 8
    (label :class "section-title"
            :text "CPU Usage")
    (progress :value "${cpu_usage}"
              :class "cpu-progress")
    (label :class "section-value"
            :text "${cpu_usage}%")
    (label :class "section-detail"
            :text "Load Average: ${load_avg}")))

(defwidget memory-details []
  (box :class "monitor-section"
       :orientation "v"
       :spacing 8
    (label :class "section-title"
            :text "Memory Usage")
    (progress :value "${memory_usage}"
              :class "memory-progress")
    (label :class "section-value"
            :text "${memory_usage}%")
    (label :class "section-detail"
            :text "Used: ${memory_used}GB / Total: ${memory_total}GB")))

(defwidget disk-details []
  (box :class "monitor-section"
       :orientation "v"
       :spacing 8
    (label :class "section-title"
            :text "Disk Usage")
    (progress :value "${disk_usage}"
              :class "disk-progress")
    (label :class "section-value"
            :text "${disk_usage}%")
    (label :class "section-detail"
            :text "Used: ${disk_used}GB / Total: ${disk_total}GB")))

(defwidget network-details []
  (box :class "monitor-section"
       :orientation "v"
       :spacing 8
    (label :class "section-title"
            :text "Network")
    (label :class "network-status"
            :text "${network.connected ? 'Connected' : 'Disconnected'}")
    (label :class "network-detail"
            :text "${network.connected ? network.ssid : 'No connection'}")))